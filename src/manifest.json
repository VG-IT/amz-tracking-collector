{
  "manifest_version": 3,
  "name": "Amazon Tracking Collector",
  "version": "1.1.0",
  "description": "Collect Amazon orders and tracking, then sync to fulfill.everymarket.com",
  "action": {
    "default_popup": "index.html",
    "default_title": "Amazon Tracking Collector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab", "alarms"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.ca/*",
    "https://fulfill.everymarket.com/*",
    "https://logging.everymarket.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.ca/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
